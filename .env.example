# Sao chep .env.example thanh .env va tao mat khau bang scripts/init-env.sh
COMPOSE_PROJECT_NAME=ecoshopde3
LAB_HTTP_PORT=18080
# 127.0.0.1: an toan theo mac dinh, dung SSH tunnel neu tren Windows
LAB_BIND_IP=127.0.0.1
LAB_PMA_PORT=18081
LAB_GRAFANA_PORT=13000
LAB_PROMETHEUS_PORT=19090
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_PASSWORD=GENERATE_BEFORE_DEPLOY
MYSQL_ROOT_PASSWORD=GENERATE_BEFORE_DEPLOY
MYSQL_EXPORTER_PASSWORD=GENERATE_BEFORE_DEPLOY
GRAFANA_ADMIN_USER=ecoshopadmin
GRAFANA_ADMIN_PASSWORD=GENERATE_BEFORE_DEPLOY
# SMTP chi nhap khi can kiem thu email, dung App Password moi
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
